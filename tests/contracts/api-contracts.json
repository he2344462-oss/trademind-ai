{
  "envelope": {
    "success": ["code", "message", "data"],
    "optional": ["traceId"],
    "errorCodeRule": "code must be non-zero for business errors"
  },
  "endpoints": [
    { "method": "POST", "path": "/api/v1/candidates/:id/analyze", "auth": true, "responseData": "CandidateAnalysisResult" },
    { "method": "GET", "path": "/api/v1/candidates/:id/analysis", "auth": true, "responseData": "CandidateAnalysis" },
    { "method": "GET", "path": "/api/v1/candidates/:id/analyses", "auth": true, "responseData": "CandidateAnalysisList" },
    { "method": "GET", "path": "/api/v1/cost-center", "auth": true, "responseData": "CostCenterSummary" },
    { "method": "GET", "path": "/api/v1/candidate-analysis-batches", "auth": true, "responseData": "CandidateAnalysisBatchPage" },
    { "method": "GET", "path": "/api/v1/candidate-analysis-batches/:id/items", "auth": true, "responseData": "CandidateAnalysisBatchItemPage" },
    { "method": "POST", "path": "/api/v1/candidate-analysis-batches/:id/pause", "auth": true, "responseData": "BatchControlResult" },
    { "method": "POST", "path": "/api/v1/candidate-analysis-batches/:id/resume", "auth": true, "responseData": "BatchControlResult" },
    { "method": "POST", "path": "/api/v1/candidate-analysis-batches/:id/cancel", "auth": true, "responseData": "BatchControlResult" },
    { "method": "POST", "path": "/api/v1/candidate-analysis-batches/:id/retry-failed", "auth": true, "responseData": "BatchControlResult" },
    { "method": "POST", "path": "/api/v1/market-signals/import", "auth": true, "responseData": "MarketSignalImportResult" },
    { "method": "GET", "path": "/api/v1/market-signal-providers/status", "auth": true, "responseData": "MarketSignalProviderStatusList" },
    { "method": "POST", "path": "/api/v1/performance/import", "auth": true, "responseData": "PerformanceImportResult" },
    { "method": "GET", "path": "/api/v1/performance/summary", "auth": true, "responseData": "PerformanceSummary" },
    { "method": "GET", "path": "/api/v1/evaluation/selection-performance", "auth": true, "responseData": "SelectionPerformanceReport" },
    { "method": "GET", "path": "/api/v1/auth/profile", "auth": true, "responseData": "AdminProfile" },
    { "method": "GET", "path": "/api/v1/image/providers", "auth": true, "responseData": "ImageProviderList" },
    { "method": "GET", "path": "/api/v1/products/:id", "auth": true, "responseData": "ProductDetail" },
    { "method": "GET", "path": "/api/v1/products/:id/readiness", "auth": true, "query": ["platform", "shopId", "mode"], "responseData": "ProductReadinessResult" },
    { "method": "GET", "path": "/api/v1/products/:id/publications", "auth": true, "responseData": "ProductPublicationList" },
    { "method": "GET", "path": "/api/v1/product-publications/:id/douyin/sku-bindings", "auth": true, "responseData": "DouyinSkuBindingSummary" },
    { "method": "GET", "path": "/api/v1/products/:id/publish-targets", "auth": true, "responseData": "PublishTargetsResponse" },
    {
      "method": "POST",
      "path": "/api/v1/products/:id/platform-configs/douyin_shop/create-draft",
      "auth": true,
      "requestBody": ["shopId", "publishMode", "force"],
      "responseData": "ProductPublishTaskDTO"
    },
    {
      "method": "POST",
      "path": "/api/v1/products/:id/publish",
      "auth": true,
      "requestBody": ["shopId", "options", "force"],
      "responseData": "ProductPublishTaskDTO"
    }
  ]
}
