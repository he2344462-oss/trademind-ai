    { "method": "POST", "path": "/api/v1/listing-drafts/:id/ready", "auth": true, "responseData": "ListingDraft" },
    { "method": "POST", "path": "/api/v1/listing-drafts/:id/publish-packages", "auth": true, "responseData": "ListingPublishPackage" },
