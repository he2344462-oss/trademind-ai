    { "method": "POST", "path": "/api/v1/selection-configs/:id/activate", "auth": true, "responseData": "SelectionConfig" },
    { "method": "GET", "path": "/api/v1/listing-drafts/:id/workspace", "auth": true, "responseData": "ListingWorkspace" },
